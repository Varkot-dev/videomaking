{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3); \"$PY\" \"$CLAUDE_PROJECT_DIR/manimgen/scripts/env_doctor.py\" 1>&2 || echo '[env-doctor] Blocking setup issues detected above. Fix them before running the manimgen pipeline.' 1>&2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_manim.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_python.py\""
          }
        ]
      }
    ]
  }
}
